# Pengembangan lokal: jalankan `pnpm dev:db` (MongoDB replica set in-memory, data di .data/mongo)
MONGODB_URI=mongodb://127.0.0.1:27017/danboy?replicaSet=rs0
# Kosongkan REDIS_URL di lokal: job dijalankan in-process oleh web. Produksi wajib diisi.
REDIS_URL=
AUTH_SECRET=ganti-dengan-32-byte-acak
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
UPLOAD_MAX_MB=20
AMBANG_MENDEKATI_PERSEN=90
TZ=Asia/Jakarta
LOG_LEVEL=info
# Sandi awal akun baru & reset sandi (wajib diganti saat masuk pertama). Kosongkan untuk sandi acak per akun.
# Jangan tulis di kode/repositori; repositori ini publik.
SANDI_AWAL=

# Modul Hibah dan Bansos. Buat dengan `pnpm hibah:seed --kunci`. Kunci yang SAMA dipakai di lokal dan Netlify;
# kehilangan KUNCI_ENKRIPSI berarti NIK tersimpan tidak bisa dibuka lagi, jadi simpan salinannya di tempat aman.
KUNCI_ENKRIPSI=
KUNCI_SIDIK=
CRON_SECRET=
# OAuth Google Drive (cakupan drive.file) untuk berkas usulan; redirect = <alamat situs>/api/hibah/drive/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/hibah/drive/oauth/callback
